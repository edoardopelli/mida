# Copia questo file in .env e personalizza i valori.
# Il file .env non deve essere committato nel repository.
#
# MongoDB gira solo nella rete interna Docker e non viene pubblicato
# sull'host: non servono utente e password per il database.

# Cartella dei download da cui MIDA importa i file DidUP Family.
# Su macOS: apri Terminale e incolla `echo $HOME/Downloads` per ottenere il percorso.
DOWNLOADS_PATH=/Users/tuo-utente/Downloads

# Primo anno dell'anno scolastico: 2026 significa settembre 2026 - agosto 2027.
SCHOOL_YEAR_START=2026

# Monitoraggio della cartella Downloads.
IMPORT_MONITORING_ENABLED=true
IMPORT_POLL_INTERVAL_MS=5000
IMPORT_STABILITY_SCANS=2
IMPORT_MAX_FILE_SIZE_BYTES=10485760
IMPORT_DELETE_AFTER_IMPORT=true

# Notifiche Web Push.
NOTIFICATIONS_ENABLED=true

# Chiavi VAPID: se entrambe vuote MIDA le genera al primo avvio e le conserva
# nel volume MongoDB. Non perdere il volume, altrimenti le sottoscrizioni
# esistenti smettono di funzionare.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mida@localhost

# Google / Gmail / Classroom (opzionale).
# Il client OAuth non si configura qui: scarica il JSON da Google Cloud e
# importalo da Impostazioni → Account Google (guida in /guida-google).
GOOGLE_ENABLED=true
GOOGLE_GMAIL_ENABLED=true
GOOGLE_GMAIL_QUERY=from:didup
GOOGLE_GMAIL_MAX_RESULTS=50
GOOGLE_GMAIL_SYNC_INTERVAL_MS=300000
GOOGLE_GMAIL_INITIAL_DELAY_MS=30000
GOOGLE_CLASSROOM_ENABLED=true
GOOGLE_CLASSROOM_ANNOUNCEMENTS=true
GOOGLE_MAX_ATTACHMENT_SIZE_BYTES=104857600

# Utente con cui gira il backend nel container.
# Su macOS puoi usare `id -u` e `id -g` (di norma 501 e 20).
# Su Linux usa lo stesso utente proprietario della cartella Downloads.
MIDA_UID=501
MIDA_GID=20
